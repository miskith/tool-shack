{
  "name": "tool-shack",
  "version": "1.1.0",
  "description": "Collection of usefull functions to ease work",
  "author": {
    "name": "David Myška",
    "url": "https://www.davidmyska.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/miskith/tool-shack/issues"
  },
  "homepage": "https://storage.davidmyska.com/tool-shack/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miskith/tool-shack.git"
  },
  "type": "module",
  "module": "dist/esm/index.js",
  "main": "dist/cjs/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }, null, 2) + '\\n')\"",
    "format": "pretty-quick",
    "generate-docs": "node -e \"require('node:fs').rmSync('docs', { recursive: true, force: true })\" && typedoc --name \"Tool-Shack\" --readme README.md src/*/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack": "node scripts/pack-smoke.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.5.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
