{
  "name": "tool-shack",
  "version": "1.1.2",
  "description": "Collection of usefull functions to ease work",
  "author": {
    "name": "David Myška",
    "url": "https://www.davidmyska.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/miskith/tool-shack/issues"
  },
  "homepage": "https://storage.davidmyska.com/tool-shack/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miskith/tool-shack.git"
  },
  "type": "module",
  "module": "dist/esm/index.js",
  "main": "dist/cjs/index.cjs",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./browser": {
      "types": "./dist/esm/browser/index.d.ts",
      "import": "./dist/esm/browser/index.js",
      "require": "./dist/cjs/browser/index.cjs"
    },
    "./dateTime": {
      "types": "./dist/esm/dateTime/index.d.ts",
      "import": "./dist/esm/dateTime/index.js",
      "require": "./dist/cjs/dateTime/index.cjs"
    },
    "./dom": {
      "types": "./dist/esm/dom/index.d.ts",
      "import": "./dist/esm/dom/index.js",
      "require": "./dist/cjs/dom/index.cjs"
    },
    "./general": {
      "types": "./dist/esm/general/index.d.ts",
      "import": "./dist/esm/general/index.js",
      "require": "./dist/cjs/general/index.cjs"
    },
    "./schedule": {
      "types": "./dist/esm/schedule/index.d.ts",
      "import": "./dist/esm/schedule/index.js",
      "require": "./dist/cjs/schedule/index.cjs"
    },
    "./storage": {
      "types": "./dist/esm/storage/index.d.ts",
      "import": "./dist/esm/storage/index.js",
      "require": "./dist/cjs/storage/index.cjs"
    },
    "./string": {
      "types": "./dist/esm/string/index.d.ts",
      "import": "./dist/esm/string/index.js",
      "require": "./dist/cjs/string/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rslib build",
    "format": "oxfmt",
    "generate-docs": "node -e \"require('node:fs').rmSync('docs', { recursive: true, force: true })\" && typedoc --name \"Tool-Shack\" --readme README.md src/*/index.ts",
    "lint": "rslint .",
    "lint:fix": "rslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.1",
    "@rslint/core": "^0.9.3",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.70.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
